   "source": [
    "# On ajoute une colonne pour donner le nombre d'acteurs oscarisés dans les films\n",
    "\n",
    "df_reg2 = df[df[\"release_date\"] <= \"2016-01-01\"] # car la liste des oscars n'est plus à jour depuis 2016\n",
    "df_reg2 = df_reg2.dropna(subset = [\"principals_IMDb\"])\n",
    "df_acteurs_osc = pd.read_csv(\"../data/oscars.csv\")\n",
    "\n",
    "def compter_oscarises(liste_acteurs):\n",
    "\n",
    "    n=0\n",
    "    for acteur in liste_acteurs:\n",
    "\n",
    "        if acteur in df_acteurs_osc[\"Name\"].tolist():\n",
    "            n += 1\n",
    "    return n\n",
    "    \n",
    "\n",
    "df_reg2[\"nb_acteurs_oscarises\"] = df_reg2[\"principals_IMDb\"].apply(compter_oscarises)\n",
    "\n",
    "moyennes_osc = df_reg2.groupby(\n",
    "    \"nb_acteurs_oscarises\",\n",
    "    observed=False\n",
    ")[\"averageRating_IMDb\"].mean()\n",
    "\n",
    "moyennes_osc.plot(kind=\"bar\")\n",
    "plt.xlabel(\"Nombre d'acteurs oscarisés\")\n",
    "plt.ylabel(\"Évaluation moyenne\")\n",
    "plt.title(\"Évaluation moyenne des films selon leur nombre d'acteurs oscarisés\")\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
