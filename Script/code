import pandas
import imdb.imdb
import matplotlib
import tmdb
import asyncio
from tmdb import route, schema
import python-dotenv

async def main():
    base = route.Base()
    base.key = "CLÉ API"

    movies = await route.Movie().search("fight club")
    for movie in movies:
        print(movie["name"])

    movies = movies.to(schema.Movies)  # convert `dict` to `schema.Movies`
    for movie in movies:
        print(movie.name)

asyncio.run(main())